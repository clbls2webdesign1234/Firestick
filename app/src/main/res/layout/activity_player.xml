<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="27dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/pill_bg"
        android:maxWidth="520dp"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/controls_scrim"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="56dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/disc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="62dp"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/seek_focus"
                android:focusable="true"
                android:nextFocusDown="@+id/btn_play" />

            <TextView
                android:id="@+id/length"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="62dp"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_prev"
                style="@style/Round"
                android:contentDescription="Previous chapter"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btn_rew"
                style="@style/Round"
                android:contentDescription="Back 10 seconds"
                android:src="@drawable/ic_rew" />

            <ImageButton
                android:id="@+id/btn_play"
                style="@style/Round"
                android:contentDescription="Pause"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btn_fwd"
                style="@style/Round"
                android:contentDescription="Forward 30 seconds"
                android:src="@drawable/ic_fwd" />

            <ImageButton
                android:id="@+id/btn_next"
                style="@style/Round"
                android:contentDescription="Next chapter"
                android:src="@drawable/ic_next" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_disc_menu"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Disc menu"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_audio"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Audio" />

            <Button
                android:id="@+id/btn_subs"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Subtitles" />

            <Button
                android:id="@+id/btn_chapters"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Chapters" />

            <Button
                android:id="@+id/btn_more"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingTop="27dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/panel_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:divider="@null"
            android:listSelector="@drawable/row_selector"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:text="Back: previous page     Menu: close"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
